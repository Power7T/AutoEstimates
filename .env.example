# === Required ===
OPENROUTER_API_KEY=your_openrouter_api_key_here

# === CapCut Login (optional — first run opens browser for manual login) ===
CAPCUT_EMAIL=your_capcut_email@example.com
CAPCUT_PASSWORD=your_capcut_password_here

# === Browser ===
HEADLESS=true

# === Model routing (override defaults) ===
# Vision/analysis model — watches your video clips
VISION_MODEL=google/gemini-flash-1.5
# Planning model — decides creative edit decisions
PLANNER_MODEL=meta-llama/llama-3.1-70b-instruct
# Director model — final quality creative decisions
DIRECTOR_MODEL=anthropic/claude-sonnet-4-6

# === Whisper (speech transcription) ===
# tiny | base | small | medium | large
WHISPER_MODEL=base

# === Feature flags ===
ENABLE_TRENDS=true
ENABLE_TASTE_LEARNING=true
ENABLE_BEAT_SYNC=true
